// bench: what a log call costs. Run with `mbuild bench` (release build).
//
//   off        a debug call while the filter is at info
//   on/null    an info record formatted as logfmt, written to a writer that
//              throws it away
//   json/null  the same as JSON
//   async      logfmt through an async queue to /dev/null, 4 threads
import "std/io";
import "std/time";
import "std/thread";
import "std/file";
import "log/log";

const N = 2000000;

fn null_write(ctx: rawptr, p: uint8*, n: int64) -> int64 { return n; }

fn per_call(label: string, t0: int64, n: int64) {
  var ns: int64 = time_mono_ns() - t0;
  var each: float64 = (float64)ns / (float64)n;
  println("{label}: {each} ns per call");
}

var g_lg: LogLogger* = (LogLogger*)0;

fn worker(arg: cstring) -> uint32 {
  for i in 0..N / 4 {
    log_info(g_lg, "request", log_str("path", "/api/v1/items"), log_int("status", 200), log_int("i", (int64)i));
  }
  return 0;
}

fn main() -> int32 {
  var sink: LogSink* = log_sink_new(LOG_FMT_LOGFMT, 0);
  sink->write = &null_write;
  log_add_sink(sink);
  log_set_filter("info");
  var lg: LogLogger* = log_logger("bench");

  var t0: int64 = time_mono_ns();
  for i in 0..N { log_debug(lg, "hidden", log_int("i", (int64)i)); }
  per_call("off       ", t0, (int64)N);

  t0 = time_mono_ns();
  for i in 0..N { log_info(lg, "request", log_str("path", "/api/v1/items"), log_int("status", 200), log_int("i", (int64)i)); }
  per_call("on/null   ", t0, (int64)N);

  sink->fmt.kind = LOG_FMT_JSON;
  t0 = time_mono_ns();
  for i in 0..N { log_info(lg, "request", log_str("path", "/api/v1/items"), log_int("status", 200), log_int("i", (int64)i)); }
  per_call("json/null ", t0, (int64)N);
  log_shutdown();

  var dn: LogSink* = log_sink_file("/dev/null", LOG_FMT_LOGFMT, 0, 0, 0);
  log_sink_async(dn, 8192, LOG_BLOCK);
  log_add_sink(dn);
  g_lg = lg;
  t0 = time_mono_ns();
  var hs: int64[4];
  for t in 0..4 { hs[t] = CreateThread(0, 0, &worker, (cstring)0, 0, 0); }
  for t in 0..4 { thread_join_infinite(hs[t]); thread_close(hs[t]); }
  log_flush();
  per_call("async x4  ", t0, (int64)N);
  log_shutdown();
  return 0;
}
