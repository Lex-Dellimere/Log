// mbuild.mettle: the project file for log. `mbuild help` lists its commands.
//
// Layout: src/log.mettle is the facade; modules sit in src/log/.
// Tests: tests/<name>_test.mettle, run with `mbuild test` and `mbuild test -r`.
import "mbuild/api";

fn project() {
  mb_package("log", "0.1.0");
  mb_meta("description", "structured logging for Mettle: levels, fields, RUST_LOG-style filters, async sinks, rotation, JSON, logfmt, syslog and journald");
  mb_meta("license", "Apache-2.0");
  mb_meta("repository", "https://github.com/Lex-Dellimere/Log");
  mb_import_root("src");
  mb_bin("bench", "bench/bench.mettle");
  mb_bin("hello", "examples/hello.mettle");
}

fn deps() {
  mb_dep_path("codec", "../codec");
}

// bench: build the benchmark in release and run it (`mbuild bench`).
fn cmd_bench(a: MbArgs*) -> int32 {
  if (mb_mbuild("build -r") != 0) { return 1; }
  return mb_cmd_run(mb_cmd(mb_out("bench", mb_os(), "release")));
}
